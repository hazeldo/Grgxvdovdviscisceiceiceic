From e190c3e20e3c62958a326c97631d407bfdc758ce Mon Sep 17 00:00:00 2001
From: hazeldo <haze@lxcamail.com>
Date: Fri, 16 Oct 2026 20:57:07 +0000
Subject: [PATCH 3/4] Restrict update downloads to this repository's release
 assets

The updater accepted any https://github.com/ URL. Only paths under
/BoiHanny/vrcosc-magicchatbox/releases/download/ are now accepted.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WMSS7CpBx5NLw6UbNJMmE3
---
 vrcosc-magicchatbox/Classes/DataAndSecurity/UpdateApp.cs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/vrcosc-magicchatbox/Classes/DataAndSecurity/UpdateApp.cs b/vrcosc-magicchatbox/Classes/DataAndSecurity/UpdateApp.cs
index 5b2d19a..a5a1369 100644
--- a/vrcosc-magicchatbox/Classes/DataAndSecurity/UpdateApp.cs
+++ b/vrcosc-magicchatbox/Classes/DataAndSecurity/UpdateApp.cs
@@ -22,6 +22,10 @@ public class UpdateApp
     private static int _legacyWorkspacesChecked;
     private const string ExecutableName = "MagicChatbox.exe";
     private const int UpdateLocationMetadataVersion = 2;
+    // Only release assets of this repository may be installed; any other github.com path
+    // (another user's repository, a raw file, an archive link) is refused.
+    private static readonly string ReleaseDownloadPathPrefix =
+        new Uri(Core.Constants.GitHubRepoUrl).AbsolutePath.TrimEnd('/') + "/releases/download/";
     private string backupPath = string.Empty;
     private string currentAppPath = string.Empty;
     private readonly string dataPath;
@@ -405,7 +409,9 @@ public class UpdateApp
         if (string.IsNullOrWhiteSpace(updateUrl) ||
             !Uri.TryCreate(updateUrl, UriKind.Absolute, out var uri) ||
             uri.Scheme != "https" ||
-            !uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase))
+            !uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase) ||
+            !uri.AbsolutePath.StartsWith(ReleaseDownloadPathPrefix, StringComparison.OrdinalIgnoreCase) ||
+            uri.AbsolutePath.Contains("/../", StringComparison.Ordinal))
         {
             throw new InvalidOperationException($"Untrusted update URL rejected: {updateUrl}");
         }
