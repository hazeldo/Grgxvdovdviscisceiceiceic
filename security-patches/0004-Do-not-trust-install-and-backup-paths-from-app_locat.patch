+using System;
+using System.IO;
+using vrcosc_magicchatbox.Classes.DataAndSecurity;
+using Xunit;
+
+namespace MagicChatbox.Tests.Core.Updates;
+
+public class UpdateInstallDirectoryGuardTests : IDisposable
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "mcb-guard-" + Guid.NewGuid().ToString("N"));
+
+    public UpdateInstallDirectoryGuardTests() => Directory.CreateDirectory(_root);
+
+    public void Dispose()
+    {
+        try { Directory.Delete(_root, true); } catch (IOException) { }
+    }
+
+    [Fact]
+    public void A_dedicated_folder_holding_the_app_is_accepted()
+    {
+        string install = Directory.CreateDirectory(Path.Combine(_root, "MagicChatbox")).FullName;
+        File.WriteAllText(Path.Combine(install, "MagicChatbox.exe"), string.Empty);
+
+        Assert.True(UpdateApp.IsSafeInstallDirectory(install, out _));
+    }
+
+    [Fact]
+    public void A_folder_without_the_app_is_refused()
+    {
+        string other = Directory.CreateDirectory(Path.Combine(_root, "Photos")).FullName;
+
+        Assert.False(UpdateApp.IsSafeInstallDirectory(other, out string reason));
+        Assert.Contains("MagicChatbox.exe", reason);
+    }
+
+    [Fact]
+    public void The_windows_directory_is_refused()
+        => Assert.False(UpdateApp.IsSafeInstallDirectory(
+            Environment.GetFolderPath(Environment.SpecialFolder.System), out _));
+
+    [Fact]
+    public void A_drive_root_is_refused()
+        => Assert.False(UpdateApp.IsSafeInstallDirectory(Path.GetPathRoot(_root), out _));
+
+    [Fact]
+    public void Personal_folders_are_refused_even_when_the_app_was_unpacked_into_them()
+    {
+        Assert.False(UpdateApp.IsSafeInstallDirectory(
+            Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), out _));
+        Assert.False(UpdateApp.IsSafeInstallDirectory(
+            Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), out _));
+        Assert.False(UpdateApp.IsSafeInstallDirectory(Path.GetTempPath(), out _));
+    }
+}
