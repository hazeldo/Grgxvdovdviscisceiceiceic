+    private static bool IsSameOrInside(string path, string root)
+    {
+        string fullPath = Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+        string fullRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+        return fullPath.Equals(fullRoot, StringComparison.OrdinalIgnoreCase) ||
+               fullPath.StartsWith(fullRoot + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase);
+    }
+
+    /// <summary>
+    /// The install directory is wiped before new files are copied in, possibly by an elevated
+    /// process. Its path is read from app_location.json, which any program running as the user can
+    /// rewrite, so it is only trusted when it really looks like a MagicChatbox installation and is
+    /// not a system or personal folder. Without this, editing the JSON and starting
+    /// "MagicChatbox.exe -update" deleted any folder (and, after the UAC prompt the updater raises
+    /// itself, any system folder) and replaced it with files from the user-writable update workspace.
+    /// </summary>
+    public static bool IsSafeInstallDirectory(string? path, out string reason)
+    {
+        reason = string.Empty;
+        if (string.IsNullOrWhiteSpace(path))
+        {
+            reason = "no install directory is known";
+            return false;
+        }
+
+        string fullPath;
+        try
+        {
+            fullPath = Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+        }
+        catch (Exception ex) when (ex is ArgumentException or NotSupportedException or PathTooLongException)
+        {
+            reason = "the install directory path is invalid";
+            return false;
+        }
+
+        string? root = Path.GetPathRoot(fullPath)?.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+        if (string.IsNullOrEmpty(root) || fullPath.Equals(root, StringComparison.OrdinalIgnoreCase))
+        {
+            reason = $"{fullPath} is a drive root";
+            return false;
+        }
+
+        string windows = Environment.GetFolderPath(Environment.SpecialFolder.Windows);
+        if (!string.IsNullOrEmpty(windows) && IsSameOrInside(fullPath, windows))
+        {
+            reason = $"{fullPath} is inside the Windows directory";
+            return false;
+        }
+
+        string userProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+        string[] protectedFolders =
+        {
+            userProfile,
+            string.IsNullOrEmpty(userProfile) ? string.Empty : Path.Combine(userProfile, "Downloads"),
+            Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
+            Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory),
+            Environment.GetFolderPath(Environment.SpecialFolder.CommonDesktopDirectory),
+            Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
+            Environment.GetFolderPath(Environment.SpecialFolder.MyMusic),
+            Environment.GetFolderPath(Environment.SpecialFolder.MyPictures),
+            Environment.GetFolderPath(Environment.SpecialFolder.MyVideos),
+            Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
+            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+            Environment.GetFolderPath(Environment.SpecialFolder.CommonApplicationData),
+            Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles),
+            Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86),
+            Environment.GetFolderPath(Environment.SpecialFolder.CommonProgramFiles),
+            Environment.GetFolderPath(Environment.SpecialFolder.CommonProgramFilesX86),
+            Environment.GetFolderPath(Environment.SpecialFolder.Programs),
+            Environment.GetFolderPath(Environment.SpecialFolder.Startup),
+            Environment.GetFolderPath(Environment.SpecialFolder.CommonStartup),
+            Path.GetTempPath()
+        };
+
+        foreach (string folder in protectedFolders)
+        {
+            if (string.IsNullOrWhiteSpace(folder))
+                continue;
+
+            string protectedPath = Path.GetFullPath(folder).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
+            if (fullPath.Equals(protectedPath, StringComparison.OrdinalIgnoreCase))
+            {
+                reason = $"{fullPath} is a system or personal folder, not a dedicated MagicChatbox folder";
+                return false;
+            }
+        }
+
+        if (!File.Exists(Path.Combine(fullPath, ExecutableName)))
+        {
+            reason = $"{fullPath} does not contain {ExecutableName}";
+            return false;
+        }
+
+        return true;
+    }
+
+    private bool EnsureSafeInstallDirectory(string operation)
+    {
+        if (IsSafeInstallDirectory(currentAppPath, out string reason))
+            return true;
+
+        Logging.WriteException(
+            new Exception($"{operation} was stopped before touching any files: {reason}. " +
+                          "Put MagicChatbox in its own folder and start it from there."),
+            MSGBox: true,
+            autoclose: true);
+        return false;
+    }
+
